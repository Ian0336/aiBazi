# AI Bazi Backend Environment Configuration
# Copy this file to .env and modify as needed

# =============================================================================
# Server Settings
# =============================================================================

HOST=0.0.0.0
PORT=8000

# =============================================================================
# CORS / Frontend
# =============================================================================

# Allowed origins for CORS (comma-separated list)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend base URL — used for OAuth redirect after Google callback
FRONTEND_URL=http://localhost:3000

# =============================================================================
# Database (Postgres)
# =============================================================================

DATABASE_URL=postgresql+psycopg2://aibazi:aibazi@localhost:5432/aibazi

# =============================================================================
# JWT
# =============================================================================

# 產生方式: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_COOKIE_NAME=aibazi_refresh

# Set true behind HTTPS. Lax works when frontend + backend share an eTLD+1 (localhost dev,
# or e.g. api.example.com + app.example.com both under example.com). For cross-domain
# deployments use COOKIE_SAMESITE=none + COOKIE_SECURE=true.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# =============================================================================
# Google OAuth
# =============================================================================

# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# =============================================================================
# AI / NVIDIA NIM
# =============================================================================

# 從 https://build.nvidia.com 申請的 API key（nvapi-xxxx）
NVIDIA_API_KEY=

NV_AI_BASE_URL=https://integrate.api.nvidia.com/v1
NV_AI_MODEL=deepseek-ai/deepseek-v4-pro

# =============================================================================
# AI Quota
# =============================================================================

# 每用戶每日 AI 分析次數上限（成功的呼叫才算）
AI_DAILY_QUOTA=3

# 單次回應 token 上限（完整 6 段分析約需 6000-8000 tokens）
AI_MAX_TOKENS=8192

# 單次 NV NIM 呼叫 timeout
AI_TIMEOUT_SECONDS=240

# Quota 每日重置使用的時區
AI_QUOTA_TIMEZONE=Asia/Taipei
