# AI Bazi Backend Environment Configuration
# Copy this file to .env and modify as needed

# =============================================================================
# Server Settings
# =============================================================================

# Server host (default: 0.0.0.0)
HOST=0.0.0.0

# Server port (default: 8000)
PORT=8000

# =============================================================================
# CORS Settings
# =============================================================================

# Allowed origins for CORS (comma-separated list)
# Examples:
#   Single origin: http://localhost:3000
#   Multiple origins: http://localhost:3000,https://example.com,https://app.example.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# =============================================================================
# AI / NVIDIA NIM
# =============================================================================

# 從 https://build.nvidia.com 申請的 API key（nvapi-xxxx）
NVIDIA_API_KEY=

# 預設使用的命盤分析模型
NV_AI_MODEL=deepseek-ai/deepseek-v4-pro
